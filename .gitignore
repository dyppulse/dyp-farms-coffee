# Dependencies
node_modules/

# Build output
dist/
build/

# @dyp/payments is consumed via a `file:` dependency from backend, and its
# tsc build has proven flaky on some hosts' npm (missing @types/node
# resolution). Commit its compiled output so deploys don't depend on
# rebuilding it. Rebuild locally with `npm run build` after editing its src.
!packages/payments/dist/
!packages/payments/dist/**

# Environment & secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Tests
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
detox-artifacts/
artifacts/

# TypeScript
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Expo / React Native (mobile/)
.expo/
web-build/
expo-env.d.ts
.metro-health-check*

# Native signing & credentials (mobile/)
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Husky (backend/; generated internals only)
.husky/_
