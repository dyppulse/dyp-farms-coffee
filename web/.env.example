# The app calls its own /api. In dev the Vite server proxies it to this backend:
VITE_DEV_API=http://localhost:3001
# Optional: override the API base (leave unset normally).
# VITE_API_BASE=

# Needed only for the admin Farms Map page (Google Maps JavaScript API).
# Get a key at https://console.cloud.google.com/google/maps-apis and enable
# "Maps JavaScript API".
VITE_GOOGLE_MAPS_API_KEY=
