# Backend API base URL. Defaults to the deployed Render API if unset.
VITE_API_URL=http://localhost:3001/api

# Needed only for the admin Farms Map page (Google Maps JavaScript API).
# Get a key at https://console.cloud.google.com/google/maps-apis and enable
# "Maps JavaScript API".
VITE_GOOGLE_MAPS_API_KEY=
