generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries. On Neon this is the POOLED host (…-pooler…) so serverless
  // scale-to-zero and many short connections don't exhaust Postgres.
  url       = env("DATABASE_URL")
  // Migrations / introspection need a direct (non-pooled) connection: pgbouncer
  // doesn't support the session features `prisma migrate` relies on. Locally this
  // is simply the same URL as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  farmer
  roaster
  tourist
  admin
}

enum AuctionStatus {
  active
  ended
}

enum TourType {
  tour
  accommodation
  tasting
}

enum SlotStatus {
  open
  full
  cancelled
}

enum BookingStatus {
  pending_payment
  confirmed
  cancelled
  expired
}

enum PaymentMethod {
  mtn_momo
  airtel_money
}

enum TransactionType {
  tour_booking
  shop_order
  deposit
  withdrawal
  refund
}

enum TransactionProvider {
  mtn_momo
  airtel_money
  wallet
  system
}

enum TransactionStatus {
  pending
  completed
  failed
}

enum PaymentAttemptStatus {
  initiated
  pending
  successful
  failed
  expired
}

enum NotificationType {
  bid
  grading
  payment
  shipment
  weather
  general
}

enum TicketStatus {
  open
  in_progress
  resolved
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

// Teams a ticket can be escalated to.
enum TicketTeam {
  payments
  logistics
  quality
  agronomy
  engineering
}

enum TicketEntryKind {
  comment
  event
}

// Finished-goods ("value addition") catalog: roasted/branded retail product,
// as opposed to the raw green-coffee CoffeeLot records traded in the
// marketplace/auction (CoffeeLot).
// A Product targets one or more sales channels so the same catalog can power
// the farm-tour upsell, a diaspora storefront, and B2B wholesale ordering.
enum ProductCategory {
  retail
  gift_set
  wholesale
}

enum ShopChannel {
  tourism
  diaspora
  b2b
  direct
}

enum ShopOrderStatus {
  pending_payment
  confirmed
  cancelled
  expired
  fulfilled
}

enum DeliveryMethod {
  pickup
  shipping
}

model Product {
  id          String          @id @default(cuid())
  name        String
  description String
  category    ProductCategory
  channels    ShopChannel[]
  roastLevel  String?
  weightGrams Int?
  unit        String          @default("bag")
  priceUgx    Int
  minOrderQty Int             @default(1)
  imageUrl    String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  orderItems  OrderItem[]

  @@index([category])
}

model ShopOrder {
  id              String                @id @default(cuid())
  userId          String
  channel         ShopChannel
  status          ShopOrderStatus       @default(pending_payment)
  subtotal        Int
  deliveryFee     Int                   @default(0)
  totalAmount     Int
  currency        String                @default("UGX")
  deliveryMethod  DeliveryMethod
  deliveryAddress String?
  paymentMethod   PaymentMethod
  paymentPhone    String
  confirmedAt     DateTime?
  expiresAt       DateTime
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  items           OrderItem[]
  transactions    Transaction[]
  paymentAttempts OrderPaymentAttempt[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String    @id @default(cuid())
  orderId   String
  order     ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Int
  lineTotal Int

  @@index([orderId])
}

model OrderPaymentAttempt {
  id                String               @id @default(cuid())
  orderId           String
  order             ShopOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          PaymentMethod
  phoneNumber       String
  amount            Int
  currency          String               @default("UGX")
  providerReference String?
  status            PaymentAttemptStatus @default(initiated)
  rawResponse       Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([orderId])
  @@index([providerReference])
}

model Tour {
  id            String     @id
  title         String
  description   String
  type          TourType
  duration      String
  rating        Float      @default(0)
  reviewCount   Int        @default(0)
  locationName  String
  address       String
  city          String
  country       String     @default("Uganda")
  latitude      Float?
  longitude     Float?
  pricePerGuest Int
  currency      String     @default("UGX")
  bookingFee    Int        @default(5000)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  slots         TourSlot[]
  reviews       Review[]
  bookings      Booking[]
}

model TourSlot {
  id           String     @id @default(cuid())
  tourId       String
  tour         Tour       @relation(fields: [tourId], references: [id], onDelete: Cascade)
  date         DateTime   @db.Date
  startTime    String
  endTime      String
  capacity     Int
  bookedGuests Int        @default(0)
  status       SlotStatus @default(open)
  bookings     Booking[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([tourId, date])
}

model Review {
  id        String   @id
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  userName  String
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  @@index([tourId])
}

model Booking {
  id              String           @id @default(cuid())
  userId          String
  tourId          String
  tour            Tour             @relation(fields: [tourId], references: [id])
  slotId          String
  slot            TourSlot         @relation(fields: [slotId], references: [id])
  guests          Int
  subtotal        Int
  bookingFee      Int
  totalAmount     Int
  currency        String           @default("UGX")
  status          BookingStatus    @default(pending_payment)
  ticketCode      String?          @unique
  paymentMethod   PaymentMethod
  paymentPhone    String
  confirmedAt     DateTime?
  expiresAt       DateTime
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  transactions    Transaction[]
  paymentAttempts PaymentAttempt[]

  @@index([userId])
  @@index([status])
}

model Transaction {
  id                String              @id @default(cuid())
  userId            String
  bookingId         String?
  booking           Booking?            @relation(fields: [bookingId], references: [id])
  shopOrderId       String?
  shopOrder         ShopOrder?          @relation(fields: [shopOrderId], references: [id])
  type              TransactionType
  provider          TransactionProvider
  amount            Int
  currency          String              @default("UGX")
  status            TransactionStatus   @default(pending)
  externalReference String?
  description       String
  metadata          Json?
  createdAt         DateTime            @default(now())

  @@index([userId])
  @@index([bookingId])
  @@index([shopOrderId])
}

model PaymentAttempt {
  id                String               @id @default(cuid())
  bookingId         String
  booking           Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider          PaymentMethod
  phoneNumber       String
  amount            Int
  currency          String               @default("UGX")
  providerReference String?
  status            PaymentAttemptStatus @default(initiated)
  rawResponse       Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([bookingId])
  @@index([providerReference])
}

// Farm, Notification, Ticket etc. reference users by plain string id (ownerId/userId/
// entityId) rather than a real FK, so they stay decoupled from the User table.
model Farm {
  id           String   @id @default(cuid())
  ownerId      String
  name         String
  sizeHectares Float?
  boundary     Json // [{ lat, lng }, ...] polygon points; a single-point "pin" is a 1-element array
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  body       String
  entityType String?
  entityId   String?
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([userId])
  @@index([userId, read])
}

model Ticket {
  id                    String          @id @default(cuid())
  userId                String
  subject               String
  body                  String
  status                TicketStatus    @default(open)
  priority              TicketPriority  @default(normal)
  team                  TicketTeam? // team that currently owns the ticket, set on escalation
  // Set when the reporter asks for escalation; cleared once an admin escalates.
  escalationRequestedAt DateTime?
  escalatedAt           DateTime?
  comments              TicketComment[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@index([team])
}

// A comment or a timeline event on a ticket. authorId isn't a real FK, so author
// name/role are denormalised at write time.
model TicketComment {
  id         String          @id @default(cuid())
  ticketId   String
  ticket     Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  authorName String
  authorRole String
  kind       TicketEntryKind @default(comment)
  body       String
  internal   Boolean         @default(false) // staff-only note, hidden from the reporter
  createdAt  DateTime        @default(now())

  @@index([ticketId, createdAt])
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String
  name         String
  role         UserRole           @default(roaster)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  lots         CoffeeLot[]
  bids         Bid[]
  cartItems    CartItem[]
  receipts     WarehouseReceipt[]
}

model CoffeeLot {
  id           String             @id @default(cuid())
  lotNumber    Int                @unique @default(autoincrement())
  name         String
  origin       String
  grade        String             @default("Ungraded")
  price        Float              @default(0)
  cuppingNotes String             @default("")
  traceability String
  warehouse    String             @default("unassigned")
  quantity     Float
  unit         String             @default("kg")
  imageUrl     String?
  inAuction    Boolean            @default(false)
  farmerId     String?
  farmer       User?              @relation(fields: [farmerId], references: [id], onDelete: SetNull)
  farmId       String?
  createdAt    DateTime           @default(now())
  auction      Auction?
  cartItems    CartItem[]
  receipts     WarehouseReceipt[]

  @@index([farmerId])
}

model Auction {
  id         String         @id @default(cuid())
  lotId      String         @unique
  lot        CoffeeLot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  currentBid Float
  endsAt     DateTime
  status     AuctionStatus  @default(active)
  createdAt  DateTime       @default(now())
  bids       Bid[]
  autoBids   AutoBidLimit[]
}

model Bid {
  id         String   @id @default(cuid())
  auctionId  String
  auction    Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bidderName String
  amount     Float
  createdAt  DateTime @default(now())

  @@index([auctionId, createdAt])
}

model AutoBidLimit {
  auctionId  String
  auction    Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId     String
  bidderName String
  maxAmount  Float

  @@id([auctionId, userId])
}

model CartItem {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lotId    String
  lot      CoffeeLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  quantity Int       @default(1)

  @@unique([userId, lotId])
}

model WarehouseReceipt {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lotId           String
  lot             CoffeeLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  lotName         String
  variety         String
  quantity        Float
  unit            String
  grade           String
  moistureLevel   Float
  storageLocation String
  gpsLocation     Json?
  qualityScore    Int
  estimatedValue  Float
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([lotId])
}

// ───── Community, financing and subscriptions ─────
// userId columns are plain strings (no FK), like Farm/Notification/Ticket: AccountService
// deletes the personal rows explicitly, and keeps financing records for legal retention.

enum CommunityCategory {
  discussion
  tips
  news
  question
}

enum FinancingStatus {
  pending
  approved
  rejected
  funded
  repaid
}

enum SubscriptionStatus {
  active
  paused
  cancelled
}

enum DeliveryFrequency {
  weekly
  biweekly
  monthly
}

model CommunityPost {
  id        String              @id @default(cuid())
  userId    String
  userName  String
  userRole  String
  title     String
  content   String
  category  CommunityCategory
  likeCount Int                 @default(0)
  createdAt DateTime            @default(now())
  replies   CommunityReply[]
  likes     CommunityPostLike[]

  @@index([category, createdAt])
  @@index([createdAt])
  @@index([userId])
}

model CommunityReply {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  userName  String
  content   String
  createdAt DateTime      @default(now())

  @@index([postId, createdAt])
  @@index([userId])
}

model CommunityPostLike {
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime      @default(now())

  @@id([postId, userId])
  @@index([userId])
}

model ChatConversation {
  id        String        @id @default(cuid())
  userId    String
  createdAt DateTime      @default(now())
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  userName       String
  message        String
  isAgent        Boolean          @default(false)
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

model FinancingRequest {
  id              String          @id @default(cuid())
  userId          String
  lotId           String
  receiptId       String
  requestedAmount Int
  interestRate    Float
  duration        Int
  status          FinancingStatus @default(pending)
  monthlyPayment  Float
  totalRepayment  Float
  dueDate         DateTime
  createdAt       DateTime        @default(now())
  approvedAt      DateTime?
  fundedAt        DateTime?

  @@index([userId, createdAt])
  @@index([receiptId])
  @@index([status])
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String
  planId          String
  planName        String
  status          SubscriptionStatus @default(active)
  frequency       DeliveryFrequency
  nextDeliveryAt  DateTime
  nextPaymentAt   DateTime
  totalSpent      Float              @default(0)
  bagsSent        Int                @default(0)
  createdAt       DateTime           @default(now())

  @@index([userId, status])
}
