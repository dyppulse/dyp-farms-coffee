PORT=3001
JWT_SECRET=change-me-to-a-long-random-string
# Production only: browser origins allowed by CORS (comma-separated; defaults to the
# Render web app). Any origin is allowed when NODE_ENV is not production.
# CORS_ORIGINS=https://dyp-farms-web.onrender.com
# Production only: the demo admin (admin@dypfarms.com) is not loaded in production.
# Set both to create a real admin (password 12+ chars). SEED_DEMO_USERS=false also
# drops the farmer/buyer/tourist demo accounts.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# SEED_DEMO_USERS=true
API_PUBLIC_URL=http://localhost:3001/api

# Set to false to switch payments off (no providers, payment routes answer 503).
# PAYMENTS_ENABLED=false
PAYMENTS_MOCK=true

# PostgreSQL
# Local dev (docker compose up -d): both URLs are the same.
DATABASE_URL=postgresql://dyp:dyp@localhost:5432/dyp_farms?schema=public
DIRECT_URL=postgresql://dyp:dyp@localhost:5432/dyp_farms?schema=public
#
# Neon (production): see backend/prisma/README.md
#   DATABASE_URL = POOLED string  (host contains "-pooler")  — used by the running API
#     postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15
#   DIRECT_URL   = DIRECT string  (no "-pooler")             — used by `prisma migrate`
#     postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15

# Email (optional in dev — logs to console if SMTP_HOST unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Dyp Farms <noreply@dypfarms.com>

# MTN MoMo (https://momodeveloper.mtn.com)
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENV=sandbox
MTN_MOMO_CALLBACK_URL=http://localhost:3001/api/webhooks/mtn-momo

# Airtel Money (https://developers.airtel.africa)
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_PIN=
AIRTEL_COUNTRY=UG
AIRTEL_CALLBACK_URL=http://localhost:3001/api/webhooks/airtel-money

# Gemini vision (free-tier demo). Get a key: https://aistudio.google.com/apikey
# FUTURE: upgrade to paid vision API or a custom-trained coffee grading model.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash
