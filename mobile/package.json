{
  "name": "dyp-farms-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "check-node": "node -e \"const p=process.versions.node.split('.').map(Number);const ok=p[0]>20||(p[0]===20&&p[1]>19)||(p[0]===20&&p[1]===19&&p[2]>=4);if(!ok){console.error('\\nExpo SDK 54 requires Node >= 20.19.4 (you have '+process.versions.node+').\\nRun: nvm use\\n');process.exit(1)}\"",
    "prestart": "npm run check-node",
    "preandroid": "npm run check-node",
    "preios": "npm run check-node",
    "preweb": "npm run check-node",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "detox test --configuration ios.sim.debug --cleanup",
    "test:e2e:build": "detox build-framework-cache && detox build-app --configuration ios.sim.debug",
    "test:playwright": "playwright test",
    "test:all": "npm run test && npm run test:playwright && npm run test:e2e"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~16.0.0",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-react": "^7.25.0",
    "@babel/preset-typescript": "^7.25.0",
    "@testing-library/react-native": "^12.0.0",
    "@types/jest": "^29.5.11",
    "@types/react": "~19.1.10",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "~54.0.11",
    "detox": "^20.15.0",
    "detox-cli": "^20.15.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-expo": "^54.0.18",
    "playwright": "^1.40.0",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/e2e/playwright/",
      "<rootDir>/e2e/detox/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/index.tsx"
    ]
  }
}
